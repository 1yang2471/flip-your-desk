#!/bin/sh
# tidy: 单个提交文件超过 ~5000 token（20KB）就拒绝，请按功能拆分。
# agent 不会读的文件跳过：lockfile、构建产物、二进制资产。
# 存量超标文件在 oversized-allowlist 白名单里（拆分决定权在用户），不受拦截。
MAX=20000
ALLOWLIST="$(git rev-parse --show-toplevel)/.githooks/oversized-allowlist"
fail=0
for f in $(git diff --cached --name-only --diff-filter=ACMR); do
  case "$f" in
    *lock.json | *Cargo.lock | *.png | *.gif | *.ico | *.jpg | *.jpeg | *.webp | *.svg | *.exe | *.msi) continue ;;
  esac
  if [ -f "$ALLOWLIST" ] && grep -qxF "$f" "$ALLOWLIST"; then
    continue
  fi
  size=$(git cat-file -s ":$f" 2>/dev/null || wc -c < "$f")
  if [ "$size" -gt "$MAX" ]; then
    echo "✗ 提交被拒：$f 为 $size 字节（> ${MAX}B ≈ 5000 token）。请按功能拆分后再提交；存量超标文件若已在 .githooks/oversized-allowlist 白名单则放行。" >&2
    fail=1
  fi
done

# 发版一致性：README 安装节必须引用与 package.json 同版本的安装包名（v0.1.1 曾漏改 README，防复发）。
# 查提交树（:file）；文件未入 index 时回退工作区文件。
version=$(grep -m1 '"version"' package.json | sed 's/[^0-9.]*\([0-9][0-9.]*\).*/\1/')
case "$version" in
  '' | *[!0-9.]*)
    echo "✗ 提交被拒：无法从 package.json 读到版本号，无法检查 README 安装节一致性。" >&2
    exit 1 ;;
esac
for f in README.md README.en.md; do
  content=$(git show ":$f" 2>/dev/null || cat "$f")
  if ! printf '%s' "$content" | grep -qF "Desk_${version}_x64"; then
    echo "✗ 提交被拒：$f 安装节未引用与 package.json 同版本（$version）的安装包名（形如 Flip.Your.Desk_${version}_x64-setup.exe）。发版 bump 时需同步更新 README.md / README.en.md 安装节。" >&2
    fail=1
  fi
done
exit $fail
